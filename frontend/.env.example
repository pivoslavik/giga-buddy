# Copy to .env.local and adjust if needed.

# Origin of the API when the static frontend is hosted separately from it.
# Leave empty to call the same origin (nginx proxies /api to the backend).
VITE_API_URL=

# Where `npm run dev` proxies /api requests: nginx from docker compose (default)
# or a locally started backend, e.g. http://localhost:8080
API_PROXY_TARGET=http://localhost
